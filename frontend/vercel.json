{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    { "source": "/static/demo.jsonl", "headers": [{ "key": "Content-Type", "value": "application/x-ndjson; charset=utf-8" }] }
  ]
}
